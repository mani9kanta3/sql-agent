# Copy this file to backend/.env and fill it in.
# .env is gitignored. This file is the one that gets committed.

# ---------------------------------------------------------------- database

DB_NAME=sql_agent
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# The owner. Used only by scripts/setup_database.py and scripts/seed.py.
# No code inside app/ can see these.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your_postgres_password

# The agent's credential. SELECT only. setup_database.py creates this
# role with whatever password you put here, so pick one now.
DB_RO_USER=sql_agent_ro
DB_RO_PASSWORD=pick_a_password_for_the_readonly_role

# The monitoring credential. INSERT on agent_query_log and nothing else.
# Leave the password blank and the query log is off and nothing breaks.
DB_LOG_USER=sql_agent_log
DB_LOG_PASSWORD=pick_a_password_for_the_log_role

# ---------------------------------------------------------------- envelope

# Layer 2. A bad join is killed rather than left sitting there.
STATEMENT_TIMEOUT_MS=5000

# A LIMIT is forced on every query at this number.
MAX_ROWS=200

# How many result rows the model is shown when it writes the answer.
ROWS_SHOWN_TO_MODEL=30

# ------------------------------------------------------------------- agent

# Three attempts, then it fails honestly and shows what it tried.
MAX_ATTEMPTS=3

# Tables put in the prompt normally, and after an unknown column error.
TABLES_RETRIEVED=5
TABLES_RETRIEVED_WIDE=9

SAMPLE_ROWS=3

# ------------------------------------------------------------------ models

# "groq" or "gemini"
LLM_PROVIDER=groq

GROQ_API_KEY=

# Optional second key. The free tier is 200,000 tokens a day and one
# evaluation run over both modes needs about 180,000, so one key gives
# you a single experiment per day. When the first key hits its daily cap
# the agent switches to this one instead of waiting.
GROQ_API_KEY_EXTRA=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# What the model charges, dollars per million tokens. Langfuse has no
# price list for Groq, so cost is worked out from these and sent with
# each traced generation. Change them if you change the model.
MODEL_INPUT_COST_PER_M=0.15
MODEL_OUTPUT_COST_PER_M=0.60

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where the embedding model is downloaded to. Point it somewhere with
# space; the model is about 130 MB.
MODEL_DIR=E:/Full Stack and AI/SQL Agent Project/models

# ----------------------------------------------------------------- tracing

# Optional. Leave blank and tracing is off and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local

# --------------------------------------------------------------------- api

CORS_ORIGINS=http://localhost:5173
