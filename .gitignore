# Secrets. The API keys and both database passwords live here.
.env
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/

# The embedding model download, about 130 MB.
models/

# Node
node_modules/
dist/

# Evaluation output. Written by eval/run_eval.py.
#
# latest.json and comparison.json are committed on purpose, because the
# numbers in the README come from them and anyone reading it should be
# able to check where they came from. Everything else is scratch.
backend/data/eval/*
!backend/data/eval/latest.json
!backend/data/eval/comparison.json
!backend/data/eval/baseline.json

# The schema vectors and the snapshot ARE committed, which is a change
# from how this started. They are generated, but generating them needs a
# live database and the embedding model, and the deployed container has
# neither at build time. They are small, deterministic, and required at
# runtime by retrieval and by the drift check.

# Timestamped copies of every evaluation run. Insurance against
# overwriting results, which I have done. Not for anyone else to read.
backend/data/eval/runs/


# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
